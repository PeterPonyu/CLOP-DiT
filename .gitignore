# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/

# Data (large files — binary embeddings and h5ad)
data/cached_latents*/
data/processed_h5ad/*.h5ad
data/processed_h5ad/*.json
data/processed_h5ad_v*/

# Model weights and training artifacts (large binary files)
models/scgpt_human/
models/scgpt_pancancer/
models/checkpoints/*.pth
models/checkpoints/*.json
models/checkpoints/archive/
models/checkpoints_v*/

# Generated outputs
results/
figures_v*/
# Root figures/ is deprecated; pipeline uses results/figures/ and articles/figures/ (symlinks)
figures/
generated_*.h5ad

# Logs
logs/
*.log
*.aux
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# Config archives
configs/archive/

# Doc archives (AI session reports)
docs/archive/
docs/intermediate_analysis/
!docs/intermediate_analysis/README.md

# Scripts archive
scripts/archive/

# Misc generated files
preprocess_embeddings
arch-figure/node_modules/
arch-figure/.nuxt/
arch-figure/.output/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.egg
package-lock.json

# Root archive (allow README, ignore subdirectories if created)
archive/*/
!archive/README.md

# Generated figure PNGs (generated on demand from PDFs)
results/figures/generated_pngs/

# LaTeX auxiliary files (explicitly listed for clarity)
articles/*.aux
articles/*.log
articles/*.out
articles/*.toc
articles/*.synctex.gz
articles/*.fdb_latexmk
articles/*.fls
articles/*.bbl
articles/*.blg
