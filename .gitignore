# ============================================================
# CLOP-DiT .gitignore — GitHub-ready (strict binary blocking)
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/

# === Binary safeguards (prevent accidental large-file commits) ===
*.pth
*.pt
*.onnx
*.safetensors
*.npy
*.npz
*.h5ad
*.h5
*.hdf5
*.parquet
*.feather
*.pkl
*.pickle

# === Data (large files) ===
data/

# === Model weights ===
models/scgpt_human/
models/scgpt_pancancer/
models/checkpoints/
!models/checkpoints/.gitkeep
!models/checkpoints/CURRENT_VERSION.txt
models/baselines/

# === Generated outputs ===
results/
logs/
figures/
figures_v*/
generated_*.h5ad

# === Archives (historical, not for public repo) ===
configs/archive/
scripts/archive/

# === Agent / IDE / working artifacts ===
prompts.md
*.prompt.md

# === LaTeX auxiliary files ===
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
articles/*.aux
articles/*.log
articles/*.out
articles/*.toc
articles/*.synctex.gz
articles/*.fdb_latexmk
articles/*.fls
articles/*.bbl
articles/*.blg

# === Nuxt / Node (if any remain) ===
node_modules/
.nuxt/
.output/
package-lock.json

# === Jupyter ===
.ipynb_checkpoints/

# === IDE ===
.vscode/
.idea/

# === OS ===
.DS_Store
Thumbs.db

# === Environment ===
.env
