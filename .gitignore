# ============================================================
# CLOP-DiT .gitignore — GitHub-ready (strict binary blocking)
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/

# === Binary safeguards (prevent accidental large-file commits) ===
*.pth
*.pt
*.onnx
*.safetensors
*.npy
*.npz
*.h5ad
*.h5
*.hdf5
*.parquet
*.feather
*.pkl
*.pickle

# === Data (large files) ===
data/

# === Model weights ===
models/scgpt_human/
models/scgpt_pancancer/
models/checkpoints/
!models/checkpoints/.gitkeep
models/baselines/

# === Generated outputs ===
results/
logs/
figures/
figures_v*/
generated_*.h5ad

# === Archives (historical, not for public repo) ===
configs/archive/
scripts/archive/

# === Claude Code agent artifacts ===
.claude/
CLAUDE.md

# === Agent / IDE / working artifacts ===
prompts.md
*.prompt.md

# === LaTeX auxiliary files ===
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
articles/*.aux
articles/*.log
articles/*.out
articles/*.toc
articles/*.synctex.gz
articles/*.fdb_latexmk
articles/*.fls
articles/*.bbl
articles/*.blg

# === Nuxt / Node (if any remain) ===
node_modules/
.nuxt/
.output/
package-lock.json

# === Jupyter ===
.ipynb_checkpoints/

# === IDE ===
.vscode/
.idea/

# === OS ===
.DS_Store
Thumbs.db

# === Environment ===
.env

# === Articles & cover letters (not for remote) ===
articles/
articles_elsevier/
articles_elsevier copy/
articles.zip
cover_letter.md
cover_letter.pdf

# === Intermediate project markdown files ===
PIPELINE.md
CONTRIBUTING.md
REPRODUCIBILITY.md
VERSIONS.md
IMPROVEMENT_PLAN.md
AUDIT_INDEX.md
FOLDER_REVIEW.md

# === Fetched reference articles ===
references/

# === Fonts (copyrighted, not distributable) ===
fonts/
*.ttf

# === Internal docs (not for public repo) ===
docs/

# === Internal maintenance / audit scripts ===
scripts/pipeline/generate_folder_audit_reports.py
scripts/analysis/audit_data.py

# === VCD tooling (internal development tool) ===
scripts/vcd/
