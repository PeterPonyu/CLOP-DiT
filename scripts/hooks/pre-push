#!/usr/bin/env bash
# Pre-push guard — block pushes that would ship a submission PDF
# containing literal "??" artefacts (unresolved LaTeX cross-references).
#
# Install via:
#   ln -sf "$(pwd)/scripts/hooks/pre-push" .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PDFS=(
  "$REPO_ROOT/revision/manuscripts/v2_revision/clop_dit_manuscript.pdf"
  "$REPO_ROOT/revision/manuscripts/diff/clop_dit_manuscript.diff.pdf"
  "$REPO_ROOT/revision/response_letter/rebuttal_letter.pdf"
  "$REPO_ROOT/revision/response_letter/revision_cover_letter.pdf"
)

if ! command -v pdftotext >/dev/null 2>&1; then
  echo "[pre-push] pdftotext not available; skipping '??' guard" >&2
  exit 0
fi

failed=0
for pdf in "${PDFS[@]}"; do
  if [[ ! -f "$pdf" ]]; then
    continue  # untracked/gitignored builds — nothing to check
  fi
  hits=$(pdftotext "$pdf" - 2>/dev/null | grep -c "??" || true)
  if [[ "$hits" -gt 0 ]]; then
    echo "[pre-push] BLOCKED: $hits literal '??' in $(basename "$pdf")" >&2
    failed=1
  fi
done

if [[ "$failed" -ne 0 ]]; then
  echo "[pre-push] Fix the unresolved LaTeX \\ref{} or hardcode the target numeral, rebuild the PDF, then push again." >&2
  echo "[pre-push] Bypass with 'git push --no-verify' only if you know what you are doing." >&2
  exit 1
fi

exit 0
