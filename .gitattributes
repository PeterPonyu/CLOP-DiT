# Git LFS tracking rules (for future large-file management)
# If using Git LFS, uncomment the rules below and run: git lfs install

# *.pth filter=lfs diff=lfs merge=lfs -text
# *.pt filter=lfs diff=lfs merge=lfs -text
# *.npy filter=lfs diff=lfs merge=lfs -text
# *.h5ad filter=lfs diff=lfs merge=lfs -text
# *.npz filter=lfs diff=lfs merge=lfs -text
# Ensure consistent line endings for text files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.sh text eol=lf
*.txt text eol=lf
# Mark binary files
*.pdf binary
*.png binary
*.jpg binary
*.ttf binary
*.pth filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.h5ad filter=lfs diff=lfs merge=lfs -text
