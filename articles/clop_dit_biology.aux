\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Training Dynamics}{4}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training dynamics of the CLOP-DiT pipeline. \textbf  {Top row (CLOP)}: Contrastive loss, learned temperature ($\tau = 14.0$, fixed), batch classification accuracy, and embedding quality metrics over 200 epochs. Despite modest validation accuracy ($\sim $2.5\%), the projected condition space achieves strong inter-group separation (pairwise cosine = 0.222). \textbf  {Bottom row (DiT)}: Train and validation MSE loss (log scale), velocity cosine similarity, and learning rate schedule over 200 epochs. The EMA model (decay = 0.9999) reaches val\_cosine = 0.976, confirming accurate velocity field learning.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:training}{{2}{5}{Training dynamics of the CLOP-DiT pipeline. \textbf {Top row (CLOP)}: Contrastive loss, learned temperature ($\tau = 14.0$, fixed), batch classification accuracy, and embedding quality metrics over 200 epochs. Despite modest validation accuracy ($\sim $2.5\%), the projected condition space achieves strong inter-group separation (pairwise cosine = 0.222). \textbf {Bottom row (DiT)}: Train and validation MSE loss (log scale), velocity cosine similarity, and learning rate schedule over 200 epochs. The EMA model (decay = 0.9999) reaches val\_cosine = 0.976, confirming accurate velocity field learning}{figure.caption.2}{}}
\newlabel{fig:training@cref}{{[figure][2][]2}{[1][4][]5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}CLOP Embedding Space}{5}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Embedding space analysis. \textbf  {Top row (CLOP alignment)}: UMAP of the shared projection space showing text prototypes, cell-type clusters, and cells-per-type histogram. Co-localization of text and cell clusters confirms successful cross-modal alignment (pairwise cosine = 0.222). \textbf  {Bottom row (Real vs.\ Generated)}: UMAP comparison of real and generated cell embeddings, type-coloured, with shape-split overlay (circles = real, triangles = generated). Generated norm (20.97) closely matches real (20.89).}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:embedding-space}{{3}{6}{Embedding space analysis. \textbf {Top row (CLOP alignment)}: UMAP of the shared projection space showing text prototypes, cell-type clusters, and cells-per-type histogram. Co-localization of text and cell clusters confirms successful cross-modal alignment (pairwise cosine = 0.222). \textbf {Bottom row (Real vs.\ Generated)}: UMAP comparison of real and generated cell embeddings, type-coloured, with shape-split overlay (circles = real, triangles = generated). Generated norm (20.97) closely matches real (20.89)}{figure.caption.3}{}}
\newlabel{fig:embedding-space@cref}{{[figure][3][]3}{[1][5][]6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Core Evaluation Metrics}{6}{subsection.3.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Core evaluation results. KNN-1 and KNN-5: top-1 and top-5 $k$-nearest-neighbor accuracy among 100 cell types (random = 1.0\%). Steering: pairwise directional accuracy (random = 50\%). DivR: diversity ratio with ideal = 1.0. LinAcc: logistic regression accuracy. FD: Fr\'{e}chet distance (lower is better, but misleading for conditional generation; see text).}}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:core-results}{{1}{7}{Core evaluation results. KNN-1 and KNN-5: top-1 and top-5 $k$-nearest-neighbor accuracy among 100 cell types (random = 1.0\%). Steering: pairwise directional accuracy (random = 50\%). DivR: diversity ratio with ideal = 1.0. LinAcc: logistic regression accuracy. FD: Fr\'{e}chet distance (lower is better, but misleading for conditional generation; see text)}{table.caption.4}{}}
\newlabel{tab:core-results@cref}{{[table][1][]1}{[1][6][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Metrics dashboard summarizing conditional generation quality. KNN accuracy ($37\times $ random), steering accuracy (81\%), diversity ratio, linear classifier accuracy, and Fr\'{e}chet distance are shown across generation configurations. The collapse of unconditional generation to random baselines validates that text conditioning drives all cell-type specificity.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:metrics}{{4}{7}{Metrics dashboard summarizing conditional generation quality. KNN accuracy ($37\times $ random), steering accuracy (81\%), diversity ratio, linear classifier accuracy, and Fr\'{e}chet distance are shown across generation configurations. The collapse of unconditional generation to random baselines validates that text conditioning drives all cell-type specificity}{figure.caption.5}{}}
\newlabel{fig:metrics@cref}{{[figure][4][]4}{[1][7][]7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Per-Type Generation Quality and Text--Cell Alignment}{7}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-type fidelity and text--cell alignment. \textbf  {Top row}: Per-type centroid cosine similarity (sorted), per-type Fr\'{e}chet distance, and fidelity vs.\ dataset size scatter. Performance correlates with training abundance and inter-type expression distinctiveness. \textbf  {Bottom row}: 69$\times $69 cosine similarity heatmap between text and cell centroids (strong diagonal dominance), per-type alignment bars, and diagonal vs.\ off-diagonal distribution comparison.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:fidelity-alignment}{{5}{8}{Per-type fidelity and text--cell alignment. \textbf {Top row}: Per-type centroid cosine similarity (sorted), per-type Fr\'{e}chet distance, and fidelity vs.\ dataset size scatter. Performance correlates with training abundance and inter-type expression distinctiveness. \textbf {Bottom row}: 69$\times $69 cosine similarity heatmap between text and cell centroids (strong diagonal dominance), per-type alignment bars, and diagonal vs.\ off-diagonal distribution comparison}{figure.caption.6}{}}
\newlabel{fig:fidelity-alignment@cref}{{[figure][5][]5}{[1][7][]8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Marker Gene Fidelity}{8}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Marker gene comparison. Expression of canonical marker genes in real vs.\ generated cells across selected cell types. Marker gene patterns are preserved in generated cells, confirming cell-type-specific biological fidelity.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:markers}{{6}{9}{Marker gene comparison. Expression of canonical marker genes in real vs.\ generated cells across selected cell types. Marker gene patterns are preserved in generated cells, confirming cell-type-specific biological fidelity}{figure.caption.7}{}}
\newlabel{fig:markers@cref}{{[figure][6][]6}{[1][8][]9}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}Expression Correlation and Dimension Analysis}{9}{subsection.3.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Expression correlation analysis. Per-gene Pearson correlation between real and generated mean expression profiles, stratified by cell type. High correlation confirms that the scGPT decoder faithfully reconstructs gene-level signatures from DiT-generated latent vectors.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:expr-corr}{{7}{10}{Expression correlation analysis. Per-gene Pearson correlation between real and generated mean expression profiles, stratified by cell type. High correlation confirms that the scGPT decoder faithfully reconstructs gene-level signatures from DiT-generated latent vectors}{figure.caption.8}{}}
\newlabel{fig:expr-corr@cref}{{[figure][7][]7}{[1][9][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Expression distribution analysis. Coefficient of variation scatter, expression range with percentile bands, per-cell variability distribution, and top variable gene std ratios. Norm comparison: generated 20.97 vs.\ real 20.89.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:expr-analysis}{{8}{11}{Expression distribution analysis. Coefficient of variation scatter, expression range with percentile bands, per-cell variability distribution, and top variable gene std ratios. Norm comparison: generated 20.97 vs.\ real 20.89}{figure.caption.9}{}}
\newlabel{fig:expr-analysis@cref}{{[figure][8][]8}{[1][10][]11}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.7}Conditioning Landscape and Diversity Trade-Offs}{11}{subsection.3.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Conditioning landscape. UMAP of the CLOP condition space showing how text conditions and their corresponding generated cell clouds distribute, visualizing the text-to-cell steering mechanism.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cond-umap}{{9}{11}{Conditioning landscape. UMAP of the CLOP condition space showing how text conditions and their corresponding generated cell clouds distribute, visualizing the text-to-cell steering mechanism}{figure.caption.10}{}}
\newlabel{fig:cond-umap@cref}{{[figure][9][]9}{[1][11][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Diversity diagnostics. Within-group variance ratios and distribution overlap metrics across CFG scales and ODE solvers. KNN accuracy saturates at CFG $\approx $ 2.0--3.0 while diversity decreases monotonically.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:diversity}{{10}{12}{Diversity diagnostics. Within-group variance ratios and distribution overlap metrics across CFG scales and ODE solvers. KNN accuracy saturates at CFG $\approx $ 2.0--3.0 while diversity decreases monotonically}{figure.caption.11}{}}
\newlabel{fig:diversity@cref}{{[figure][10][]10}{[1][12][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Noise--scale trade-off and expression diversity. \textbf  {Left}: Fr\'{e}chet distance, centroid cosine, and diversity ratio as a function of noise scale $\varepsilon $ at CFG = 1.5, with the production configuration ($\varepsilon = 0.03$) highlighted. \textbf  {Right}: Gene-expression-level diversity in generated vs.\ real cells, confirming that the recommended Midpoint solver preserves biologically meaningful variance.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:diversity-tradeoff}{{11}{12}{Noise--scale trade-off and expression diversity. \textbf {Left}: Fr\'{e}chet distance, centroid cosine, and diversity ratio as a function of noise scale $\varepsilon $ at CFG = 1.5, with the production configuration ($\varepsilon = 0.03$) highlighted. \textbf {Right}: Gene-expression-level diversity in generated vs.\ real cells, confirming that the recommended Midpoint solver preserves biologically meaningful variance}{figure.caption.12}{}}
\newlabel{fig:diversity-tradeoff@cref}{{[figure][11][]11}{[1][12][]12}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.8}Baseline Comparison and Composite Benchmark}{12}{subsection.3.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Baseline comparison. Head-to-head analysis of CLOP-DiT vs.\ baselines (unconditional CFG\,=\,0, Gaussian per-type sampling, decoder-only) across four evaluation metrics (Fr\'{e}chet distance, centroid cosine similarity, diversity ratio, coverage), rendered as grouped bars, normalized radar chart, and relative improvement strip. CLOP-DiT outperforms all baselines on every metric except FD, which is dominated by mean-matching effects (see Discussion).}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:baselines}{{12}{13}{Baseline comparison. Head-to-head analysis of CLOP-DiT vs.\ baselines (unconditional CFG\,=\,0, Gaussian per-type sampling, decoder-only) across four evaluation metrics (Fr\'{e}chet distance, centroid cosine similarity, diversity ratio, coverage), rendered as grouped bars, normalized radar chart, and relative improvement strip. CLOP-DiT outperforms all baselines on every metric except FD, which is dominated by mean-matching effects (see Discussion)}{figure.caption.13}{}}
\newlabel{fig:baselines@cref}{{[figure][12][]12}{[1][13][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Composite benchmark. (\textbf  {a})~Normalized metrics heatmap (methods $\times $ eleven metrics; green = high performance). (\textbf  {b})~Composite score aggregating KNN accuracy, steering, diversity ratio, and linear separability (higher = better). (\textbf  {c})~Grouped bar chart of key metrics across methods. (\textbf  {d})~Bootstrap 95\% confidence intervals for composite scores. CLOP-DiT achieves a composite score of 0.668, confirming its advantage as an integrated text-conditioned generation system.}}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:benchmark}{{13}{14}{Composite benchmark. (\textbf {a})~Normalized metrics heatmap (methods $\times $ eleven metrics; green = high performance). (\textbf {b})~Composite score aggregating KNN accuracy, steering, diversity ratio, and linear separability (higher = better). (\textbf {c})~Grouped bar chart of key metrics across methods. (\textbf {d})~Bootstrap 95\% confidence intervals for composite scores. CLOP-DiT achieves a composite score of 0.668, confirming its advantage as an integrated text-conditioned generation system}{figure.caption.14}{}}
\newlabel{fig:benchmark@cref}{{[figure][13][]13}{[1][13][]14}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.9}Downstream Biological Validation}{14}{subsection.3.9}\protected@file@percent }
