\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Training Dynamics}{4}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training dynamics of the CLOP-DiT pipeline. \textbf  {Top row (CLOP)}: Contrastive loss, learned temperature ($\tau = 14.0$, fixed), batch classification accuracy, and embedding quality metrics over 200 epochs. Despite modest validation accuracy ($\sim $2.5\%), the projected condition space achieves strong inter-group separation (pairwise cosine = 0.222). \textbf  {Bottom row (DiT)}: Train and validation MSE loss (log scale), velocity cosine similarity, learning rate schedule, and a compact final snapshot of endpoint metrics for both stages. The EMA model (decay = 0.9999) reaches val\_cosine = 0.976, confirming accurate velocity field learning.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:training}{{2}{5}{Training dynamics of the CLOP-DiT pipeline. \textbf {Top row (CLOP)}: Contrastive loss, learned temperature ($\tau = 14.0$, fixed), batch classification accuracy, and embedding quality metrics over 200 epochs. Despite modest validation accuracy ($\sim $2.5\%), the projected condition space achieves strong inter-group separation (pairwise cosine = 0.222). \textbf {Bottom row (DiT)}: Train and validation MSE loss (log scale), velocity cosine similarity, learning rate schedule, and a compact final snapshot of endpoint metrics for both stages. The EMA model (decay = 0.9999) reaches val\_cosine = 0.976, confirming accurate velocity field learning}{figure.caption.2}{}}
\newlabel{fig:training@cref}{{[figure][2][]2}{[1][4][]5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}CLOP Embedding Space}{5}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Embedding space analysis. \textbf  {Top row (CLOP alignment)}: UMAP of the shared projection space showing text prototypes, cell-type clusters, and a cells-per-type histogram with abbreviated type labels for readability. Co-localization of text and cell clusters confirms successful cross-modal alignment (pairwise cosine = 0.222). \textbf  {Bottom row (Real vs.\ Generated)}: UMAP comparison of real and generated cell embeddings, type-coloured, with shape-split overlay (circles = real, triangles = generated). Generated norm (20.97) closely matches real (20.89).}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:embedding-space}{{3}{6}{Embedding space analysis. \textbf {Top row (CLOP alignment)}: UMAP of the shared projection space showing text prototypes, cell-type clusters, and a cells-per-type histogram with abbreviated type labels for readability. Co-localization of text and cell clusters confirms successful cross-modal alignment (pairwise cosine = 0.222). \textbf {Bottom row (Real vs.\ Generated)}: UMAP comparison of real and generated cell embeddings, type-coloured, with shape-split overlay (circles = real, triangles = generated). Generated norm (20.97) closely matches real (20.89)}{figure.caption.3}{}}
\newlabel{fig:embedding-space@cref}{{[figure][3][]3}{[1][5][]6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Core Evaluation Metrics}{6}{subsection.3.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Core evaluation results. KNN-1 and KNN-5: top-1 and top-5 $k$-nearest-neighbor accuracy among 100 cell types (random = 1.0\%). Steering: pairwise directional accuracy (random = 50\%). DivR: diversity ratio with ideal = 1.0. LinAcc: logistic regression accuracy. FD: Fr\'{e}chet distance (lower is better, but misleading for conditional generation; see text).}}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:core-results}{{1}{6}{Core evaluation results. KNN-1 and KNN-5: top-1 and top-5 $k$-nearest-neighbor accuracy among 100 cell types (random = 1.0\%). Steering: pairwise directional accuracy (random = 50\%). DivR: diversity ratio with ideal = 1.0. LinAcc: logistic regression accuracy. FD: Fr\'{e}chet distance (lower is better, but misleading for conditional generation; see text)}{table.caption.4}{}}
\newlabel{tab:core-results@cref}{{[table][1][]1}{[1][6][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Metrics dashboard summarizing conditional generation quality. The training snapshot panel uses normalized endpoint scores so loss reduction and accuracy/correlation endpoints can be compared in one view; exact final values are printed beside each row. KNN accuracy ($37\times $ random), steering accuracy (81\%), diversity ratio, linear classifier accuracy, and Fr\'{e}chet distance are shown across generation configurations. The collapse of unconditional generation to random baselines validates that text conditioning drives all cell-type specificity.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:metrics}{{4}{7}{Metrics dashboard summarizing conditional generation quality. The training snapshot panel uses normalized endpoint scores so loss reduction and accuracy/correlation endpoints can be compared in one view; exact final values are printed beside each row. KNN accuracy ($37\times $ random), steering accuracy (81\%), diversity ratio, linear classifier accuracy, and Fr\'{e}chet distance are shown across generation configurations. The collapse of unconditional generation to random baselines validates that text conditioning drives all cell-type specificity}{figure.caption.5}{}}
\newlabel{fig:metrics@cref}{{[figure][4][]4}{[1][6][]7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Per-Type Generation Quality and Text--Cell Alignment}{7}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-type fidelity and text--cell alignment. \textbf  {Top row}: Per-type centroid cosine similarity ranked across cell types, a Fr\'{e}chet outlier profile with the global mean marked, and an abundance--fidelity scatter in which bubble size is proportional to Fr\'{e}chet distance and colour encodes the per-type diversity ratio. Specific outlier type names are omitted from the bar panels for readability and are described in the surrounding text rather than directly on the bars. Together these panels expose the heterogeneity of generation quality across cell types instead of collapsing it to one mean score. \textbf  {Bottom row}: 69$\times $69 cosine similarity heatmap between text and cell centroids (strong diagonal dominance), per-type alignment bars, and diagonal vs.\ off-diagonal distribution comparison.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:fidelity-alignment}{{5}{8}{Per-type fidelity and text--cell alignment. \textbf {Top row}: Per-type centroid cosine similarity ranked across cell types, a Fr\'{e}chet outlier profile with the global mean marked, and an abundance--fidelity scatter in which bubble size is proportional to Fr\'{e}chet distance and colour encodes the per-type diversity ratio. Specific outlier type names are omitted from the bar panels for readability and are described in the surrounding text rather than directly on the bars. Together these panels expose the heterogeneity of generation quality across cell types instead of collapsing it to one mean score. \textbf {Bottom row}: 69$\times $69 cosine similarity heatmap between text and cell centroids (strong diagonal dominance), per-type alignment bars, and diagonal vs.\ off-diagonal distribution comparison}{figure.caption.6}{}}
\newlabel{fig:fidelity-alignment@cref}{{[figure][5][]5}{[1][7][]8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Marker Gene Fidelity}{8}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Marker gene comparison. Expression of canonical marker genes in real vs.\ generated cells across selected cell types. In the first panel, solid vs.\ hatched fills distinguish real vs.\ generated profiles, while bar colours group markers by lineage family (CD8 T, myeloid, epithelial, stromal); the lineage colour mapping is described in the caption rather than repeated as an in-panel legend. Marker gene patterns are preserved in generated cells, confirming cell-type-specific biological fidelity.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:markers}{{6}{9}{Marker gene comparison. Expression of canonical marker genes in real vs.\ generated cells across selected cell types. In the first panel, solid vs.\ hatched fills distinguish real vs.\ generated profiles, while bar colours group markers by lineage family (CD8 T, myeloid, epithelial, stromal); the lineage colour mapping is described in the caption rather than repeated as an in-panel legend. Marker gene patterns are preserved in generated cells, confirming cell-type-specific biological fidelity}{figure.caption.7}{}}
\newlabel{fig:markers@cref}{{[figure][6][]6}{[1][8][]9}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}Expression Correlation and Dimension Analysis}{9}{subsection.3.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Expression correlation analysis. Per-gene Pearson correlation between real and generated mean expression profiles, stratified by cell type. In the first panel, point colour encodes absolute residual magnitude, while the remaining panels summarize per-type fidelity, marker-level agreement, and the residual distribution without boxed legend frames. High correlation confirms that the scGPT decoder faithfully reconstructs gene-level signatures from DiT-generated latent vectors.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:expr-corr}{{7}{10}{Expression correlation analysis. Per-gene Pearson correlation between real and generated mean expression profiles, stratified by cell type. In the first panel, point colour encodes absolute residual magnitude, while the remaining panels summarize per-type fidelity, marker-level agreement, and the residual distribution without boxed legend frames. High correlation confirms that the scGPT decoder faithfully reconstructs gene-level signatures from DiT-generated latent vectors}{figure.caption.8}{}}
\newlabel{fig:expr-corr@cref}{{[figure][7][]7}{[1][9][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Expression distribution analysis. Coefficient of variation scatter, expression range with percentile bands, per-cell variability distribution, and the most shifted gene-level standard-deviation ratios. Norm comparison: generated 20.97 vs.\ real 20.89.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:expr-analysis}{{8}{11}{Expression distribution analysis. Coefficient of variation scatter, expression range with percentile bands, per-cell variability distribution, and the most shifted gene-level standard-deviation ratios. Norm comparison: generated 20.97 vs.\ real 20.89}{figure.caption.9}{}}
\newlabel{fig:expr-analysis@cref}{{[figure][8][]8}{[1][10][]11}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.7}Conditioning Landscape and Diversity Trade-Offs}{11}{subsection.3.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Conditioning landscape. Two-row PCA layout of the CLOP condition space showing the real reference cloud together with centroid, noisy, and variant-conditioned generations. Panel titles report the number of displayed cells and the mean within-type diversity for each conditioning mode, making the text-to-cell steering trade-offs easier to compare across modes.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cond-umap}{{9}{11}{Conditioning landscape. Two-row PCA layout of the CLOP condition space showing the real reference cloud together with centroid, noisy, and variant-conditioned generations. Panel titles report the number of displayed cells and the mean within-type diversity for each conditioning mode, making the text-to-cell steering trade-offs easier to compare across modes}{figure.caption.10}{}}
\newlabel{fig:cond-umap@cref}{{[figure][9][]9}{[1][11][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Diversity diagnostics. Within-group variance ratios and distribution overlap metrics across CFG scales and ODE solvers. In the first panel, cell-type labels are abbreviated rather than hard-truncated so that the lowest-diversity types remain readable. KNN accuracy saturates at CFG $\approx $ 2.0--3.0 while diversity decreases monotonically.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:diversity}{{10}{12}{Diversity diagnostics. Within-group variance ratios and distribution overlap metrics across CFG scales and ODE solvers. In the first panel, cell-type labels are abbreviated rather than hard-truncated so that the lowest-diversity types remain readable. KNN accuracy saturates at CFG $\approx $ 2.0--3.0 while diversity decreases monotonically}{figure.caption.11}{}}
\newlabel{fig:diversity@cref}{{[figure][10][]10}{[1][12][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Noise--scale trade-off and expression diversity. \textbf  {Top left}: Fr\'{e}chet distance, centroid cosine, and diversity ratio as a function of noise scale $\varepsilon $ at CFG = 1.5, with the production configuration ($\varepsilon = 0.03$) highlighted. \textbf  {Top right}: Gene-expression-level diversity in generated vs.\ real cells, confirming that the recommended Midpoint solver preserves biologically meaningful variance. \textbf  {Bottom}: Violin comparison of sampled pairwise cosine distributions (real--real, generated--generated, and real--generated) for the six cell types with the largest intra-type cosine shifts, revealing where diversity compression is concentrated.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:diversity-tradeoff}{{11}{13}{Noise--scale trade-off and expression diversity. \textbf {Top left}: Fr\'{e}chet distance, centroid cosine, and diversity ratio as a function of noise scale $\varepsilon $ at CFG = 1.5, with the production configuration ($\varepsilon = 0.03$) highlighted. \textbf {Top right}: Gene-expression-level diversity in generated vs.\ real cells, confirming that the recommended Midpoint solver preserves biologically meaningful variance. \textbf {Bottom}: Violin comparison of sampled pairwise cosine distributions (real--real, generated--generated, and real--generated) for the six cell types with the largest intra-type cosine shifts, revealing where diversity compression is concentrated}{figure.caption.12}{}}
\newlabel{fig:diversity-tradeoff@cref}{{[figure][11][]11}{[1][12][]13}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.8}Baseline Comparison and Composite Benchmark}{13}{subsection.3.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Baseline comparison. Head-to-head analysis of CLOP-DiT vs.\ baselines (unconditional CFG\,=\,0, Gaussian per-type sampling, decoder-only) across four evaluation metrics (Fr\'{e}chet distance, centroid cosine similarity, diversity ratio, coverage), rendered as grouped bars, a normalized radar chart, and a compact relative-improvement heatmap. CLOP-DiT outperforms all baselines on every metric except FD, which is dominated by mean-matching effects (see Discussion).}}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:baselines}{{12}{14}{Baseline comparison. Head-to-head analysis of CLOP-DiT vs.\ baselines (unconditional CFG\,=\,0, Gaussian per-type sampling, decoder-only) across four evaluation metrics (Fr\'{e}chet distance, centroid cosine similarity, diversity ratio, coverage), rendered as grouped bars, a normalized radar chart, and a compact relative-improvement heatmap. CLOP-DiT outperforms all baselines on every metric except FD, which is dominated by mean-matching effects (see Discussion)}{figure.caption.13}{}}
\newlabel{fig:baselines@cref}{{[figure][12][]12}{[1][13][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Composite benchmark. (\textbf  {a})~Normalized metrics heatmap (methods $\times $ eleven metrics; green = high performance). (\textbf  {b})~Composite score aggregating KNN accuracy, steering, diversity ratio, and linear separability (higher = better). (\textbf  {c})~Grouped comparison of the four most interpretable benchmark metrics across methods. (\textbf  {d})~Small-multiple 95\% confidence intervals for FD, centroid cosine, and diversity ratio. CLOP-DiT achieves a composite score of 0.668, confirming its advantage as an integrated text-conditioned generation system.}}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:benchmark}{{13}{14}{Composite benchmark. (\textbf {a})~Normalized metrics heatmap (methods $\times $ eleven metrics; green = high performance). (\textbf {b})~Composite score aggregating KNN accuracy, steering, diversity ratio, and linear separability (higher = better). (\textbf {c})~Grouped comparison of the four most interpretable benchmark metrics across methods. (\textbf {d})~Small-multiple 95\% confidence intervals for FD, centroid cosine, and diversity ratio. CLOP-DiT achieves a composite score of 0.668, confirming its advantage as an integrated text-conditioned generation system}{figure.caption.14}{}}
\newlabel{fig:benchmark@cref}{{[figure][13][]13}{[1][14][]14}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.9}Downstream Biological Validation}{15}{subsection.3.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Downstream validation: clustering and classifier alignment. \textbf  {Top row}: Leiden clustering on combined real + generated data with UMAP overlay, the lowest-mixing cell types, and compact cluster-alignment gauges (ARI, NMI, cluster purity, mean $k$-NN mixing). \textbf  {Bottom row}: Cell-type classification confusion matrix (real-trained on generated), a precision/recall/F1 heatmap restricted to the hardest 15 cell types, and the real-vs.-generated discriminator ROC curve. This layout exposes which cell types are genuine downstream failures versus near-perfect transfers.}}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:downstream-pq}{{14}{16}{Downstream validation: clustering and classifier alignment. \textbf {Top row}: Leiden clustering on combined real + generated data with UMAP overlay, the lowest-mixing cell types, and compact cluster-alignment gauges (ARI, NMI, cluster purity, mean $k$-NN mixing). \textbf {Bottom row}: Cell-type classification confusion matrix (real-trained on generated), a precision/recall/F1 heatmap restricted to the hardest 15 cell types, and the real-vs.-generated discriminator ROC curve. This layout exposes which cell types are genuine downstream failures versus near-perfect transfers}{figure.caption.15}{}}
\newlabel{fig:downstream-pq@cref}{{[figure][14][]14}{[1][15][]16}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces DE concordance. Effect-size-weighted real-vs.-generated log-fold-change scatter for the leading contrast, with point size proportional to average absolute effect size and colour indicating adjusted significance; sign-disagreement genes are outlined. A compact summary heatmap reports Pearson/Spearman correlation, Jaccard overlap of top DE genes, and sign agreement across the three biologically meaningful contrasts (CD8 vs.\ CD4 T, resident macrophage vs.\ monocyte, epithelial vs.\ fibroblast), replacing the previous redundant grouped-bar summary.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:downstream-r}{{15}{16}{DE concordance. Effect-size-weighted real-vs.-generated log-fold-change scatter for the leading contrast, with point size proportional to average absolute effect size and colour indicating adjusted significance; sign-disagreement genes are outlined. A compact summary heatmap reports Pearson/Spearman correlation, Jaccard overlap of top DE genes, and sign agreement across the three biologically meaningful contrasts (CD8 vs.\ CD4 T, resident macrophage vs.\ monocyte, epithelial vs.\ fibroblast), replacing the previous redundant grouped-bar summary}{figure.caption.16}{}}
\newlabel{fig:downstream-r@cref}{{[figure][15][]15}{[1][16][]16}}
